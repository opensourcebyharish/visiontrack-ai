# VisionTrack AI — backend configuration.
# Copy this file to `.env` and adjust as needed. All values are optional;
# the defaults below are what the application uses when .env is absent.

# Data directory (uploads, outputs, SQLite database). Relative paths are
# resolved against the project root.
VISIONTRACK_DATA_DIR=data

# Directory containing approved YOLO weight files (*.pt).
VISIONTRACK_MODELS_DIR=models

# Default model used for new sessions. Must be in the approved models list.
VISIONTRACK_DEFAULT_MODEL=yolo11n.pt

# Maximum upload size in megabytes.
VISIONTRACK_MAX_UPLOAD_MB=500

# Comma-separated list of accepted video extensions.
VISIONTRACK_ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,mkv,webm

# Comma-separated list of CORS origins allowed to call the API.
VISIONTRACK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bounded concurrency for inference jobs (1 keeps CPU inference predictable).
VISIONTRACK_MAX_CONCURRENT_JOBS=1
